{
  "image": "mcr.microsoft.com/devcontainers/rust:2-1-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "installDockerBuildx": true
    }
  },
  "forwardPorts": [3000],
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "customizations": {
    "vscode": {
      "settings": {
        "rust-analyzer.files.excludeDirs": ["data"],
        "code-runner.saveFileBeforeRun": true,
        "code-runner.runInTerminal": true,
        "editor.fontSize": 16,
        "terminal.integrated.fontSize": 16,
        "workbench.colorCustomizations": {
          "terminal.foreground": "#00FD61",
          "terminal.background": "#000000"
        },
        "code-runner.executorMap": {
          "c": "cd $dir && gcc $fileName -o $fileNameWithoutExt && ./$fileNameWithoutExt",
          "cpp": "cd $dir && g++ -std=c++20 $fileName -o $fileNameWithoutExt && ./$fileNameWithoutExt",
          "objective-c": "cd $dir && gcc -framework Cocoa $fileName -o $fileNameWithoutExt && $dir$fileNameWithoutExt",
          "python": "python -u",
          "go": "go run",
          "rust": "cd $dir && RUST_LOG=debug cargo run"
        },
        "code-runner.showExecutionMessage": false,
        "files.autoSave": "afterDelay",
        "explorer.confirmDelete": false,
        "explorer.confirmDragAndDrop": false,
        "workbench.colorTheme": "Delphi+ (Twilight)",
        "github.copilot.nextEditSuggestions.enabled": false,
        "terminal.integrated.shellIntegration.enabled": true,
        "diffEditor.codeLens": true,
        "rustowl.underlineThickness": "1",
        "rustowl.displayDelay": 1000,
        "vim.smartRelativeLine": true
      },
      "extensions": [
        "alefragnani.delphi-themes",
        "formulahendry.code-runner",
        "rust-lang.rust-analyzer",
        "vscodevim.vim",
        "usernamehw.errorlens",
        "vadimcn.vscode-lldb"
      ]
    }
  },
  "mounts": [
    "source=${localWorkspaceFolder}/data,target=${containerWorkspaceFolder}/data,type=bind",
  ]
}
